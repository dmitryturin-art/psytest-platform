{% extends "layout.twig" %}
{# Смена пароля кабинета владельца: отдельная сессия, навигация посетителя сюда не входит. #}
{% set ownerArea = true %}

{% block title %}Пароль кабинета — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}
<nav class="owner-nav">
    <a class="nav-link" href="{{ basePath }}/admin">Приглашения</a>
    <a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a>
    <a class="nav-link" href="{{ basePath }}/admin/tests">Методики</a>
    <a class="nav-link" href="{{ basePath }}/admin/password" aria-current="page">Пароль</a>
    <form method="post" action="{{ basePath }}/admin/logout">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="nav-link owner-logout">Выйти</button>
    </form>
</nav>
{% endblock %}

{% block content %}
<section class="owner-panel owner-password-panel" aria-labelledby="owner-password-title">
    <p class="owner-panel-eyebrow">Технический доступ</p>
    <h1 id="owner-password-title">Смена пароля</h1>
    <p class="owner-panel-intro">Новый пароль хранится только как необратимый хэш в настройках сервера; сам пароль нигде не записывается.</p>

    {% if notice %}
        <p class="owner-notice owner-notice--success" role="status">{{ notice }}</p>
    {% endif %}
    {% if error %}
        <p class="owner-notice owner-notice--error" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ basePath }}/admin/password" class="owner-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label for="owner-current-password">Текущий пароль</label>
        <input id="owner-current-password" name="current_password" type="password" autocomplete="current-password" required autofocus>
        <label for="owner-new-password">Новый пароль</label>
        <input id="owner-new-password" name="new_password" type="password" autocomplete="new-password" minlength="8" maxlength="200" required>
        <p class="owner-help">Не короче 8 символов. Короткий пароль легко подобрать: страница входа открыта в интернете.</p>
        <label for="owner-repeat-password">Повторите новый пароль</label>
        <input id="owner-repeat-password" name="repeat_password" type="password" autocomplete="new-password" minlength="8" maxlength="200" required>
        <button type="submit" class="btn btn-primary">Сохранить пароль</button>
    </form>
</section>
{% endblock %}
