{% extends "layout.twig" %}
{# Кабинет владельца — отдельная сессия: навигация посетителя сюда не входит. #}
{% set ownerArea = true %}

{% block title %}Кейс по приглашению — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">К приглашениям</a><a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-case-title">
    <p class="owner-panel-eyebrow">Кейс по приглашению</p>
    <h1 id="owner-case-title">{{ case.test_name }}</h1>
    {% if flash %}
        <p class="owner-notice owner-notice--{{ flash.type }}" role="status">{{ flash.message }}</p>
    {% endif %}
    <dl class="owner-case-details">
        <div><dt>Статус</dt><dd>{{ case.status }}</dd></div>
        <div><dt>Открыто</dt><dd>{{ case.claimed_at|date("d.m.Y H:i") }}</dd></div>
        <div><dt>Завершено</dt><dd>{% if case.completed_at %}{{ case.completed_at|date("d.m.Y H:i") }}{% else %}ещё нет{% endif %}</dd></div>
        {% if case.client_label %}<div><dt>Клиент</dt><dd><a href="{{ basePath }}/admin/clients/{{ case.client_id }}">{{ case.client_label }}</a></dd></div>{% endif %}
        {% if case.owner_note %}<div><dt>Заметка специалиста</dt><dd>{{ case.owner_note }}</dd></div>{% endif %}
    </dl>
    {% if case.completed_at %}
        <section class="owner-case-result" aria-labelledby="owner-case-result-title">
            <h2 id="owner-case-result-title">Базовый результат</h2>
            {% for section in case.result_sections %}
                <section class="results-section results-section--{{ section.type }}">
                    {% if section.title %}<h3 class="section-title">{{ section.title }}</h3>{% endif %}
                    <div class="section-body">
                        {{ include(section.block, section.data|merge({'_section_type': section.type}), ignore_missing = true) }}
                    </div>
                </section>
            {% else %}
                <p class="owner-help">Для этой методики пока нет отдельного отображения базового результата.</p>
            {% endfor %}
        </section>
    {% endif %}

    <section class="owner-case-answers" aria-labelledby="owner-case-answers-title">
        <h2 id="owner-case-answers-title">Анкета</h2>
        {% if case.answer_rows is empty %}
            <p class="owner-help">Клиент ещё не сохранил ответы.</p>
        {% else %}
            <ol class="owner-answer-list">
                {% for row in case.answer_rows %}
                    <li class="owner-answer-row">
                        <p class="owner-answer-question">{{ row.question }}</p>
                        {% if row.self_answer is defined %}
                            <dl class="owner-answer-dual">
                                <div><dt>Я</dt><dd>{{ row.self_answer }}</dd></div>
                                <div><dt>Партнёр (по мнению респондента)</dt><dd>{{ row.partner_answer }}</dd></div>
                            </dl>
                        {% else %}
                            <p class="owner-answer-value">{{ row.answer }}{% if row.score is not null %}<span> · {{ row.score }} балл.</span>{% endif %}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    {% if case.completed_at and ai.available %}
    <section class="owner-case-ai" aria-labelledby="owner-case-ai-title" data-case-reports>
        <h2 id="owner-case-ai-title">ИИ-разбор</h2>

        {% if not ai.has_jobs %}
            <p class="owner-help">Черновики заказываются один раз на оба вида: понятный разбор для клиента и профессиональное заключение для вас.</p>
            <form method="post" action="{{ basePath }}/admin/invited-case/{{ case.id }}/reports/request" class="owner-form owner-action-form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <label class="owner-field">
                    <span>Клинический контекст для модели (необязательно, до {{ ai.owner_context_max }} символов)</span>
                    <textarea name="owner_context" rows="5" maxlength="{{ ai.owner_context_max }}" placeholder="Запрос клиента, данные интервью, особенности — то, что вы обычно дописываете к промпту."></textarea>
                </label>
                <p class="owner-help">Этот блок уходит только в профессиональное заключение и заполняется вручную: подпись и заметка карточки клиента в него не подставляются.</p>
                <label><input type="checkbox" name="ai_consent" value="1" required> Передать обезличенные структурированные результаты внешнему AI-сервису; имя, email, подпись клиента и ссылка не передаются.</label>
                <button type="submit" class="btn btn-primary">Заказать черновики</button>
            </form>
        {% else %}
            <p class="owner-help">Разбор готовится несколько минут. Нажмите «Обновить», чтобы увидеть текущее состояние.</p>
            <p><a class="btn" href="{{ basePath }}/admin/invited-case/{{ case.id }}">Обновить</a></p>

            {% for item in ai.kinds %}
            <article class="owner-case-ai-item" data-kind="{{ item.kind }}" data-status="{{ item.status }}">
                <h3>{{ item.title }}</h3>
                {% if item.status == 'pending' or item.status == 'running' %}
                    <p class="owner-help" role="status">Задание в работе.</p>
                {% elseif item.status == 'failed' %}
                    <p class="owner-notice owner-notice--error" role="alert">Не получилось подготовить черновик{% if item.failure_reason %}: {{ item.failure_reason }}{% endif %}.</p>
                    <form method="post" action="{{ basePath }}/admin/invited-case/{{ case.id }}/reports/request" class="owner-action-form">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="ai_consent" value="1">
                        <button type="submit" class="btn">Повторить</button>
                    </form>
                {% elseif item.status == 'none' %}
                    <p class="owner-help">Задание не создавалось.</p>
                {% elseif item.kind == 'clear' %}
                    {% if item.published %}
                        <p class="owner-notice owner-notice--success">Опубликована версия №{{ item.published.revision_no }} от {{ item.published.published_at|date("d.m.Y H:i") }}.</p>
                    {% else %}
                        <p class="owner-help">Клиенту пока ничего не опубликовано.</p>
                    {% endif %}
                    <p><a class="btn btn-primary" href="{{ basePath }}/admin/invited-case/{{ case.id }}/reports/{{ item.report_id }}/edit">Редактировать и публиковать</a></p>
                {% else %}
                    {# Только чтение: профессиональное заключение не правится под клиента. #}
                    <details class="owner-case-ai-details">
                        <summary>Показать заключение</summary>
                        <div class="ai-report__body">{{ item.html|raw }}</div>
                    </details>
                {% endif %}
            </article>
            {% endfor %}
        {% endif %}
    </section>
    {% endif %}

    <section class="owner-case" aria-labelledby="owner-case-delete-title">
        <h2 id="owner-case-delete-title">Удаление кейса</h2>
        <p class="owner-help">Удаляются ответы, результат, заметка к назначению и сгенерированные файлы этого прохождения. Карточка клиента остаётся.</p>
        <form method="post" action="{{ basePath }}/admin/invited-case/{{ case.id }}/delete" class="owner-action-form owner-delete-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% if case.client_id %}<input type="hidden" name="client_id" value="{{ case.client_id }}">{% endif %}
            <label><input type="checkbox" name="confirm_delete" value="delete" required> Я понимаю, что удаление необратимо.</label>
            <button type="submit" class="btn btn-danger">Удалить кейс полностью</button>
        </form>
    </section>
</section>
{% endblock %}
