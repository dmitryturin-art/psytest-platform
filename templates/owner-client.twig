{% extends "layout.twig" %}
{# Кабинет владельца — отдельная сессия: навигация посетителя сюда не входит. #}
{% set ownerArea = true %}

{% block title %}Карточка клиента — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">Приглашения</a><a class="nav-link" href="{{ basePath }}/admin/clients">К списку клиентов</a><a class="nav-link" href="{{ basePath }}/admin/prompts">Промпты</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-client-title">
    <p class="owner-panel-eyebrow">Карточка клиента</p>
    <h1 id="owner-client-title">{{ client.label }}</h1>
    <p class="owner-panel-intro">Подпись, заметка и email видны только в кабинете: они не попадают в ссылку, на страницу клиента и во внешние сервисы.</p>

    {% if flash %}
        <p class="owner-notice owner-notice--{{ flash.type }}" role="status">{{ flash.message }}</p>
        {% if flash.invite_url %}<p class="owner-invite-url"><input aria-label="Ссылка-приглашение" type="text" readonly value="{{ flash.invite_url }}"></p>{% endif %}
    {% endif %}

    <section class="owner-invites" aria-labelledby="owner-client-edit-title">
        <h2 id="owner-client-edit-title">Подпись, заметка и email</h2>
        <form method="post" action="{{ basePath }}/admin/clients/{{ client.id }}/update" class="owner-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label for="client-label">Подпись клиента</label>
            <input id="client-label" name="label" type="text" maxlength="120" required autocomplete="off" value="{{ client.label }}">
            <label for="client-note">Заметка о работе</label>
            <textarea id="client-note" name="note" maxlength="1000" rows="3">{{ client.note }}</textarea>
            <label for="client-email">Email клиента (необязательно, только для уведомлений)</label>
            <input id="client-email" name="email" type="email" maxlength="254" autocomplete="off" value="{{ client.email }}">
            <p class="owner-help">Адрес нужен ровно для одного письма — «разбор готов». Платформа не отправляет его сама: письмо уходит только по вашей кнопке в карточке кейса. Очистите поле, чтобы удалить адрес.</p>
            <button type="submit" class="btn btn-primary">Сохранить</button>
        </form>
    </section>

    <section class="owner-invites" aria-labelledby="owner-client-assign-title">
        <h2 id="owner-client-assign-title">Новое назначение</h2>
        <p class="owner-help">Ссылка действует 14 дней и открывается один раз. Отправьте её клиенту сами — платформа ничего не отправляет.</p>
        {# form_key — одноразовый ключ этой отрисовки: двойное нажатие не создаёт
           второе приглашение, повтор показывает ту же ссылку (07.K6b). #}
        <form method="post" action="{{ basePath }}/admin/clients/{{ client.id }}/invites/create" class="owner-form" data-submit-once>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="form_key" value="{{ invite_form_key }}">
            <label for="assignment-test">Методика</label>
            <select id="assignment-test" name="test_id" required>
                {% for test in invite_tests %}<option value="{{ test.id }}">{{ test.name }}</option>{% endfor %}
            </select>
            <label for="assignment-note">Заметка к назначению (не показывается клиенту)</label>
            <textarea id="assignment-note" name="owner_note" maxlength="1000" rows="3"></textarea>
            <button type="submit" class="btn btn-primary" data-busy-text="Создаём…">Создать назначение</button>
        </form>
    </section>

    <section class="owner-invites" aria-labelledby="owner-client-assignments-title">
        <h2 id="owner-client-assignments-title">Назначения</h2>
        {# Фильтр по методике и переключатель архива/корзины (07.K8). По умолчанию
           архив и корзина скрыты: открываются явным выбором. #}
        <form method="get" action="{{ basePath }}/admin/clients/{{ client.id }}" class="filter-bar" aria-label="Фильтр назначений">
            <div class="filter-bar__field">
                <label for="assignment-filter-test">Методика</label>
                <select id="assignment-filter-test" name="test">
                    <option value="">Все методики</option>
                    {% for test in invite_tests %}<option value="{{ test.slug }}"{% if assignment_test == test.slug %} selected{% endif %}>{{ test.name }}</option>{% endfor %}
                </select>
            </div>
            {% if assignment_view != 'active' %}<input type="hidden" name="status" value="{{ assignment_view }}">{% endif %}
            <div class="filter-bar__actions">
                <button type="submit" class="btn btn-primary">Применить</button>
                {% if assignment_test %}<a class="btn btn-outline" href="{{ basePath }}/admin/clients/{{ client.id }}{% if assignment_view != 'active' %}?status={{ assignment_view }}{% endif %}">Сбросить</a>{% endif %}
            </div>
        </form>
        <p class="filter-counts">
            {% if assignment_view == 'active' %}Рабочие назначения{% else %}<a href="{{ basePath }}/admin/clients/{{ client.id }}{% if assignment_test %}?test={{ assignment_test }}{% endif %}">Рабочие назначения</a>{% endif %}
            · {% if assignment_view == 'archived' %}архив ({{ archived_count }}){% else %}<a href="{{ basePath }}/admin/clients/{{ client.id }}?status=archived{% if assignment_test %}&amp;test={{ assignment_test }}{% endif %}">показать архив ({{ archived_count }})</a>{% endif %}
            · {% if assignment_view == 'trash' %}корзина ({{ trashed_count }}){% else %}<a href="{{ basePath }}/admin/clients/{{ client.id }}?status=trash{% if assignment_test %}&amp;test={{ assignment_test }}{% endif %}">корзина ({{ trashed_count }})</a>{% endif %}
        </p>
        {% if assignment_view == 'trash' %}
            <p class="owner-help">Через {{ trash_days }} дней кейсы из корзины удаляются окончательно. До этого их можно восстановить.</p>
        {% endif %}
        <form method="post" action="{{ basePath }}/admin/invites/archive" id="client-bulk-form" data-bulk-form>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="form_key" value="{{ bulk_form_key }}">
            <input type="hidden" name="return" value="{{ return_url }}">
            <input type="hidden" name="confirmed" value="" data-confirmed>
            <input type="hidden" name="confirm_delete" value="" data-confirm-delete>
        </form>
        {% if assignments %}
            <ul class="owner-invite-list">
            {% for assignment in assignments %}
                <li>
                    <strong>{{ assignment.test_name }}</strong> —
                    {% include 'blocks/owner-invite-status.twig' with {invite: assignment} %}
                    <small>создано {{ assignment.created_at|date("d.m.Y H:i") }}{% if assignment.completed_at %} · завершено {{ assignment.completed_at|date("d.m.Y H:i") }}{% endif %}{% if assignment.trashed_at %} · будет удалён {{ assignment.purge_at|date("d.m.Y") }}{% endif %}</small>
                    {% if assignment.owner_note %}<p>{{ assignment.owner_note }}</p>{% endif %}
                    {% if assignment.claimed_session_id %}
                        <a class="btn btn-outline" href="{{ basePath }}/admin/invited-case/{{ assignment.claimed_session_id }}">Ответы и результат</a>
                    {% endif %}
                    {% include 'blocks/owner-invite-actions.twig' with {invite: assignment, bulk_form_id: 'client-bulk-form'} %}
                </li>
            {% endfor %}
            </ul>
        {% else %}<p class="owner-help">{% if assignment_view == 'active' and not assignment_test %}Назначений пока нет.{% else %}Здесь ничего нет.{% endif %}</p>{% endif %}
    </section>

    {% include 'blocks/owner-invite-dialog.twig' %}

    <section class="owner-case" aria-labelledby="owner-client-delete-title">
        <h2 id="owner-client-delete-title">Удаление клиента</h2>
        <p class="owner-help">Удаляются карточка, все её назначения, заметки, результаты и сгенерированные файлы. Восстановить их нельзя.</p>
        <form method="post" action="{{ basePath }}/admin/clients/{{ client.id }}/delete" class="owner-action-form owner-delete-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label><input type="checkbox" name="confirm_delete" value="delete" required> Я понимаю, что удаление необратимо.</label>
            <button type="submit" class="btn btn-danger">Удалить клиента полностью</button>
        </form>
    </section>
</section>
{% endblock %}

{% block extra_js %}
{# Блокировка кнопки после отправки; без JS повтор отсекает сервер (07.K6b). #}
<script src="{{ asset('js/owner-forms.js') }}"></script>
<script src="{{ asset('js/owner-invites.js') }}"></script>
{% endblock %}
