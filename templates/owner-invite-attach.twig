{% extends "layout.twig" %}
{# Привязка клиента без JavaScript: выбор делается здесь (07.K9). #}
{% set ownerArea = true %}

{% block title %}Привязать к клиенту — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">К приглашениям</a><a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-attach-page-title">
    <p class="owner-panel-eyebrow">Клиент</p>
    <h1 id="owner-attach-page-title">{% if invite.client_id %}Сменить клиента{% else %}Привязать к клиенту{% endif %}</h1>
    {% if invite.client_id %}
        <p class="owner-panel-intro">Сейчас привязано к клиенту «{{ invite.client_label }}».</p>
    {% else %}
        <p class="owner-panel-intro">Кейс появится в карточке выбранного клиента. Результат и ссылка не меняются.</p>
    {% endif %}
    <form method="post" action="{{ basePath }}/admin/invites/attach-client" class="owner-form" data-submit-once>
        {% include 'blocks/owner-attach-fields.twig' with {form_key: attach_form_key, uid: 'page-attach'} %}
        <p class="owner-invite-actions">
            <button type="submit" class="btn btn-primary" data-busy-text="Привязываем…">Привязать</button>
            <a class="btn btn-outline" href="{{ basePath }}{{ return_url }}">Отмена</a>
        </p>
    </form>
</section>
{% endblock %}

{% block extra_js %}
<script src="{{ asset('js/owner-forms.js') }}"></script>
{% endblock %}
