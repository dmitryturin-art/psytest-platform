{% extends "layout.twig" %}

{% block title %}Все тесты - {{ appName }}{% endblock %}

{% block body_class %}tests-list-page{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ basePath }}/css/editorial-catalog.css">
{% endblock %}

{% block content %}
<div class="editorial-catalog">
    <header class="editorial-page-heading">
        <p class="editorial-eyebrow">Каталог методик</p>
        <h1>Выберите подходящий тест</h1>
        <p>Все доступные тесты и базовые результаты бесплатны. Регистрация не нужна: ссылка на результат остаётся только у вас.</p>
    </header>

    <div class="editorial-test-grid">
        {% for test in tests %}
        <article class="editorial-test-card {% if test.slug == 'smil' %}editorial-test-card--featured{% endif %}">
            <div class="editorial-card-topline">
                <span>{% if test.slug == 'smil' %}Личность{% elseif test.slug == 'lazarus' %}Отношения{% else %}Состояние{% endif %}</span>
                <strong>Бесплатно</strong>
            </div>
            <h2>{{ test.name }}</h2>
            <p>{{ test.description|slice(0, 170) }}{% if test.description|length > 170 %}…{% endif %}</p>
            <div class="editorial-card-meta">
                <span>{{ test.question_count }} вопросов</span>
                <span>≈ {{ test.estimated_time }} мин</span>
                {% if test.slug == 'lazarus' %}<span>есть парный режим</span>{% endif %}
            </div>
            <a href="{{ basePath }}/test/{{ test.slug }}" class="editorial-card-link">Открыть тест <span aria-hidden="true">→</span></a>
        </article>
        {% endfor %}
    </div>

    {% if tests is empty %}
    <div class="empty-state">
        <div class="empty-icon">📋</div>
        <h3>Тесты пока не доступны</h3>
        <p>Попробуйте зайти позже</p>
    </div>
    {% endif %}
</div>
{% endblock %}
