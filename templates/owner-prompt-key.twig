{% extends "layout.twig" %}
{# Страница промпта в разделе «Методики» (07.K14): путь и вкладки соседних промптов,
   полоса разделов с состоянием и действиями, затем «Текущая версия», «Редактировать»,
   «История версий». Обработчики форм прежние (07.WP9/WP9b), сменились только адреса. #}
{% set ownerArea = true %}
{% set key_path = basePath ~ methodology_path ~ '/prompts/' ~ mode ~ '/' ~ kind %}
{% set kind_label = kind_title|capitalize %}
{% set mode_label = mode == 'pair' ? 'пара' : 'один человек' %}

{% block title %}{{ kind_label }} — {{ test_title }} — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}{% include 'blocks/owner-nav.twig' with {current: 'tests'} %}{% endblock %}

{% block content %}
{% set selected_entry = (versions|filter(v => v.version == selected_version)|first) ?: null %}
{% set is_published = published_version is not null and selected_version == published_version %}
{% set draft_version = state.draft_version ?? null %}
{# Заготовка (07.WP10) на экране называется «заготовка»; её номер виден только в истории. #}
{% set stub = stub_version ?? null %}
{% set selected_is_stub = stub is not null and selected_version == stub %}
{% set selected_name = selected_is_stub ? 'заготовка' : 'версия ' ~ selected_version %}
{% set selected_gen = selected_is_stub ? 'заготовки' : 'версии ' ~ selected_version %}
{% set published_is_stub = stub is not null and published_version == stub %}
<section class="owner-panel case-workspace prompt-page" aria-labelledby="owner-prompt-title"{% if trial %} data-scroll-to="prompt-trial-result"{% elseif preview %} data-scroll-to="prompt-preview"{% endif %}>
    {% include 'blocks/owner-crumbs.twig' with {items: [
        {label: 'Методики', href: basePath ~ '/admin/tests'},
        {label: test_title, href: basePath ~ methodology_path ~ (mode != 'individual' ? '?mode=' ~ mode : '') ~ '#prompts'},
        {label: kind_label ~ (mode_tabs ? ', ' ~ mode_label : '')},
    ]} %}

    <header class="case-head prompt-head">
        <h1 id="owner-prompt-title">{{ kind_label }}</h1>
        <div class="prompt-head__switch">
            {% if kind_tabs|length > 1 %}
            <nav class="view-tabs" aria-label="Вид разбора">
                {% for tab in kind_tabs %}<a class="view-tabs__tab" href="{{ basePath }}{{ tab.path }}"{% if tab.kind == kind %} aria-current="page"{% endif %}>{{ tab.title|capitalize }}</a>{% endfor %}
            </nav>
            {% endif %}
            {% if mode_tabs %}
            <nav class="view-tabs" aria-label="Режим прохождения">
                {% for tab in mode_tabs %}<a class="view-tabs__tab" href="{{ basePath }}{{ tab.path }}"{% if tab.mode == mode %} aria-current="page"{% endif %}>{{ tab.title }}</a>{% endfor %}
            </nav>
            {% endif %}
        </div>

        {% if flash %}
            <p class="owner-notice owner-notice--{{ flash.type }}" role="status">{{ flash.message }}</p>
        {% endif %}
        {% if not ai_enabled %}
            <p class="owner-help prompt-head__note" role="status">ИИ-разборы выключены для всех методик в <a href="{{ basePath }}/admin/tests/settings">настройках ИИ</a>. Редактировать промпт можно, а пробный разбор запустить нельзя.</p>
        {% endif %}
        {% if not (test_report_enabled ?? true) %}
            <p class="owner-notice owner-notice--error" role="status">ИИ-разбор этой методики выключен на <a href="{{ basePath }}{{ methodology_path }}#ai">её странице</a>: даже опубликованная версия клиентам не предлагается.</p>
        {% endif %}
    </header>

    <nav class="case-nav prompt-nav" aria-label="Разделы промпта" data-case-nav>
        <span class="case-nav__label" aria-hidden="true">{{ test_title }} · {{ kind_title }}</span>
        <div class="view-tabs case-nav__tabs">
            <a class="view-tabs__tab" href="#prompt-current" data-case-nav-link>Текст</a>
            <a class="view-tabs__tab" href="#prompt-edit" data-case-nav-link>Редактировать</a>
            <a class="view-tabs__tab" href="#prompt-history" data-case-nav-link>История</a>
        </div>
        <div class="case-nav__actions">
            {% if published_version is not null %}<span class="status status--done">{{ published_is_stub ? 'опубликована заготовка' : 'опубликована версия ' ~ published_version }}</span>
            {% else %}<span class="status status--pending">не опубликован</span>{% endif %}
            {% if draft_version %}
                {% include 'blocks/owner-publish-pop.twig' with {pop_id: 'prompt-publish', version: draft_version, stub: draft_version == stub, label: (draft_version == stub ? 'Опубликовать заготовку…' : 'Опубликовать версию ' ~ draft_version ~ '…'), primary: true} %}
            {% endif %}
            <details class="action-pop action-pop--wide" id="prompt-trial" data-action-pop>
                <summary class="btn btn-outline btn-sm">Пробный разбор</summary>
                <div class="action-pop__panel">
                    <form method="post" action="{{ key_path }}/trial" class="action-pop__form prompt-trial">
                        {{ csrf_field() }}
                        <input type="hidden" name="version" value="{{ selected_version }}">
                        <h3 class="prompt-trial__title">Пробный разбор {{ selected_gen }} на тестовых данных</h3>
                        <p class="prompt-tools__hint">Промпт отправится модели на выдуманных ответах, и вы увидите, какой разбор получится. Запрос платный, как обычный разбор; результат нигде не сохраняется, клиенты не затрагиваются.</p>
                        <label class="prompt-trial__confirm">
                            <input type="checkbox" name="confirm_trial" value="1" required>
                            <span>Подтверждаю платный пробный запрос к модели</span>
                        </label>
                        <div class="prompt-trial__actions">
                            <button type="submit" class="btn btn-outline btn-sm"{% if not ai_enabled %} disabled{% endif %}>Запустить пробный разбор</button>
                            {% if not ai_enabled %}<span class="prompt-tools__hint">ИИ-разборы выключены в настройках.</span>{% endif %}
                        </div>
                    </form>
                </div>
            </details>
        </div>
    </nav>

    {# ---------- Текущая (выбранная) версия ---------- #}
    <section id="prompt-current" class="case-section prompt-section" aria-labelledby="prompt-current-title" data-case-section>
        <h2 id="prompt-current-title">{{ is_published ? 'Действующая версия' : (selected_is_stub ? 'Черновик (заготовка)' : 'Версия ' ~ selected_version) }}</h2>
        <p class="prompt-section__lead">
            {% if published_version is null %}
            Ни одна версия ещё не опубликована: это заготовка, заказать разбор по ней нельзя. Прочитайте текст, при необходимости сохраните правку и опубликуйте нужную версию.
            {% elseif is_published %}
            По {{ published_is_stub ? 'заготовке' : 'версии ' ~ published_version }} идут новые заказы. Уже поставленные задания не меняются: у каждого свой снимок текста.
            {% else %}
            Эта версия не опубликована. Новые заказы идут по {{ published_is_stub ? 'заготовке' : 'версии ' ~ published_version }} — <a href="{{ key_path }}#prompt-current">открыть её</a>.
            {% endif %}
        </p>
        <dl class="prompt-facts">
            <div><dt>Откуда</dt><dd>{{ (selected_entry.source ?? '') == 'owner' ? 'правка из кабинета' : 'текст, поставляемый с программой' }}{% if selected_entry.created_at ?? null %}, {{ selected_entry.created_at|date("d.m.Y H:i") }}{% endif %}</dd></div>
            {% if selected_entry.note ?? null %}<div><dt>Заметка</dt><dd>{{ selected_entry.note }}</dd></div>{% endif %}
            <div><dt>Ваш клинический контекст</dt><dd>{{ selected.allowsOwnerContext ? 'учитывается, если вы добавите его к заказу' : 'не учитывается' }}</dd></div>
        </dl>
        <pre class="owner-prompt-text">{{ selected.text }}</pre>
        <div class="prompt-tools__row prompt-section__tools">
            <a class="btn btn-ghost btn-sm" href="{{ key_path }}/preview?version={{ selected_version }}#prompt-preview">Показать запрос на тестовых данных</a>
            <p class="prompt-tools__hint">Тестовые данные — выдуманный набор ответов на опросник. По ним видно, что именно уйдёт модели; реальные клиенты не затрагиваются.</p>
        </div>

        {% if preview %}
        <div id="prompt-preview" class="prompt-output" aria-labelledby="owner-prompt-preview-title">
            <h3 id="owner-prompt-preview-title">Запрос на тестовых данных</h3>
            {% if preview.error %}
                <p class="owner-notice owner-notice--error" role="alert">{{ preview.error }}</p>
            {% else %}
                <p class="owner-help">
                    Ровно то, что уйдёт модели. Ответы придуманы этой страницей по схеме методики — ни одной реальной сессии здесь нет.
                    Модель при показе запроса не вызывается.
                </p>
                {% if preview.glossary_mode %}
                <p class="owner-help">Глоссарий СМИЛ: {{ preview.glossary_mode == 'compact' ? 'компактный (краткое значение по шкалам 40–65T)' : 'полный' }}.</p>
                {% endif %}
                {% if preview.length %}
                <p class="owner-help">Длина входных данных: {{ preview.length }} знаков.</p>
                {% endif %}
                <h4>Инструкция модели (промпт)</h4>
                <pre class="owner-prompt-text">{{ preview.system }}</pre>
                <h4>Входные данные</h4>
                <pre class="owner-prompt-text">{{ preview.user }}</pre>
            {% endif %}
        </div>
        {% endif %}

        {% if trial %}
        <div id="prompt-trial-result" class="prompt-output" aria-labelledby="owner-prompt-trial-title">
            <h3 id="owner-prompt-trial-title">Пробный разбор на тестовых данных</h3>
            {% if trial.error %}
                <p class="owner-notice owner-notice--error" role="alert">{{ trial.error }}</p>
            {% else %}
                <p class="owner-help">Ответ модели{% if trial.model %} ({{ trial.model }}){% endif %}. Он не сохранён и исчезнет при перезагрузке страницы.</p>
                <div class="ai-report__body">{{ trial.text|raw }}</div>
            {% endif %}
        </div>
        {% endif %}
    </section>

    {# ---------- Редактировать: новая версия ---------- #}
    <section id="prompt-edit" class="case-section prompt-section" aria-labelledby="owner-prompt-new-title" data-case-section>
        <h2 id="owner-prompt-new-title">Редактировать</h2>
        <p class="prompt-section__lead">Основа — текст {{ selected_gen }}. «Сохранить как новую версию» ничего не публикует: опубликовать её можно потом, отдельной кнопкой.</p>
        <form method="post" action="{{ key_path }}/versions" class="owner-form" data-prompt-editor-form data-preview-url="{{ key_path }}/preview">
            {{ csrf_field() }}
            <div class="owner-field">
                <label for="prompt-text">Текст промпта</label>
                {# Поле остаётся источником правды: редактор правит его содержимое,
                   а без JS страница работает как прежде. #}
                <textarea id="prompt-text" name="text" rows="18" required data-prompt-editor>{{ selected.text }}</textarea>
            </div>

            {% if variables %}
            <div class="owner-prompt-vars" data-prompt-vars hidden>
                <label for="prompt-var-select">Вставить название поля</label>
                <select id="prompt-var-select" data-prompt-var-select>
                    <option value="">Поле входных данных…</option>
                    {% for variable in variables %}
                    <option value="{{ variable.key }}" title="{{ variable.hint }}">{{ variable.label }} ({{ variable.key }})</option>
                    {% endfor %}
                </select>
                <p class="owner-help" data-prompt-var-hint>Поля, которые модель получает во входных данных этой методики. Подстановки в тексте нет: промпт просто называет поле по имени.</p>
                <details class="prompt-vars-more">
                    <summary>Что означает каждое поле</summary>
                    <dl class="owner-prompt-vars__list">
                        {% for variable in variables %}
                        <div><dt>{{ variable.label }} <code>{{ variable.key }}</code></dt><dd>{{ variable.hint }}</dd></div>
                        {% endfor %}
                    </dl>
                </details>
            </div>
            {% endif %}

            <div class="owner-prompt-preview" data-prompt-preview-box hidden>
                <button type="button" class="btn btn-outline btn-sm" data-prompt-preview-toggle aria-expanded="false">Предпросмотр</button>
                <p class="owner-help" data-prompt-stats></p>
                <div data-prompt-preview-panel hidden>
                    <p class="owner-notice owner-notice--error" role="alert" data-prompt-preview-error hidden></p>
                    <p class="owner-help" data-prompt-preview-meta></p>
                    <h4>Инструкция модели (промпт)</h4>
                    <pre class="owner-prompt-text" data-prompt-preview-system></pre>
                    <h4>Входные данные</h4>
                    <pre class="owner-prompt-text" data-prompt-preview-user></pre>
                </div>
            </div>

            <label for="prompt-note">Заметка о правке</label>
            <input type="text" id="prompt-note" name="note" maxlength="{{ note_max }}" placeholder="Например: убрал повтор во вступлении">

            <label class="owner-toggle">
                <input type="checkbox" name="allows_owner_context" value="1"{% if selected.allowsOwnerContext %} checked{% endif %}>
                Учитывать ваш клинический контекст, если вы добавите его к заказу
            </label>

            <button type="submit" class="btn btn-outline">Сохранить как новую версию</button>
        </form>
    </section>

    {# ---------- История версий ---------- #}
    <section id="prompt-history" class="case-section prompt-section disclosure-stack" aria-labelledby="owner-prompt-versions-title" data-case-section>
        <h2 id="owner-prompt-versions-title">История версий</h2>
        <details class="ai-report__details case-fold" data-history>
            <summary class="ai-report__summary"><span class="ai-report__summary-title">Все версии</span><span class="ai-report__summary-hint">{{ versions_desc|length }}</span></summary>
            <div class="case-fold__body">
                <ul class="prompt-history">
                    {% for item in versions_desc %}
                    <li class="prompt-history__item{% if item.version == selected_version %} is-selected{% endif %}">
                        <div class="prompt-history__head">
                            <strong>{{ item.version == stub ? 'Черновик (заготовка)' : 'Версия ' ~ item.version }}</strong>{% if item.version == stub %}<span class="prompt-history__num">версия {{ item.version }}</span>{% endif %}
                            {% if item.version == published_version %}<span class="status status--done">опубликована</span>{% endif %}
                            {% if item.version == selected_version %}<span class="prompt-history__open">открыта сейчас</span>{% endif %}
                        </div>
                        <p class="prompt-history__meta">{{ item.source == 'owner' ? 'Правка из кабинета' : 'Текст, поставляемый с программой' }}{% if item.created_at %}, {{ item.created_at|date("d.m.Y H:i") }}{% endif %}{% if item.note %}. {{ item.note }}{% endif %}</p>
                        <div class="prompt-history__actions">
                            {% if item.version != selected_version %}<a class="btn btn-outline btn-sm" href="{{ key_path }}?version={{ item.version }}#prompt-current">Открыть</a>{% endif %}
                            {% if item.version != published_version %}
                                {% include 'blocks/owner-publish-pop.twig' with {pop_id: 'publish-v' ~ item.version, version: item.version, stub: item.version == stub, label: 'Опубликовать эту…', primary: false} %}
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>

                {% if has_factory_text ?? true %}
                <form method="post" action="{{ key_path }}/reset" class="owner-action-form prompt-history__reset">
                    {{ csrf_field() }}
                    <button type="submit" class="btn btn-ghost btn-sm">Вернуть заводской текст (версия {{ manifest_version }})</button>
                    <p class="owner-help">Новые заказы снова пойдут по тексту, который поставляется вместе с программой. Ваши правки останутся в истории.</p>
                </form>
                {% else %}
                <p class="owner-help prompt-history__reset">Вернуть заводской текст нельзя: заводского текста нет, это заготовка из общего шаблона.</p>
                {% endif %}
            </div>
        </details>
    </section>
</section>
{% endblock %}

{# Редактор лежит локально: внешних CDN в кабинете нет. #}
{% block extra_css %}
<link rel="stylesheet" href="{{ asset('vendor/toastui-editor/toastui-editor.min.css') }}">
{% endblock %}

{% block extra_js %}
<script src="{{ asset('vendor/toastui-editor/toastui-editor-all.min.js') }}"></script>
<script src="{{ asset('vendor/toastui-editor/i18n/ru-ru.min.js') }}"></script>
<script src="{{ asset('js/owner-prompt-editor.js') }}"></script>
<script src="{{ asset('js/owner-case-workspace.js') }}"></script>
<script src="{{ asset('js/owner-tests.js') }}"></script>
{% endblock %}
