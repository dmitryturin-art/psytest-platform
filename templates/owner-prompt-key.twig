{% extends "layout.twig" %}
{# Кабинет владельца — отдельная сессия: навигация посетителя сюда не входит. #}
{% set ownerArea = true %}
{% set key_path = basePath ~ '/admin/prompts/' ~ test ~ '/' ~ mode ~ '/' ~ kind %}

{% block title %}{{ test_title }} — {{ kind_title }} — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">Приглашения</a><a class="nav-link" href="{{ basePath }}/admin/prompts">К списку промптов</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-prompt-title">
    <p class="owner-panel-eyebrow">{{ test_title }}</p>
    <h1 id="owner-prompt-title">{{ kind_title|capitalize }}, {{ mode_title }}</h1>
    <p class="owner-panel-intro">
        Сейчас новые заказы идут по версии {{ published_version }}{% if from_manifest %} — это заводской текст, который поставляется вместе с программой{% endif %}.
        Уже поставленные задания не меняются: у каждого свой снимок промпта.
    </p>

    {% if flash %}
        <p class="owner-notice owner-notice--{{ flash.type }}" role="status">{{ flash.message }}</p>
    {% endif %}
    {% if not ai_enabled %}
        <p class="owner-notice owner-notice--error" role="status">ИИ-разборы выключены в настройках. Редактировать промпты можно, а пробный разбор запустить нельзя.</p>
    {% endif %}

    <section class="owner-invites" aria-labelledby="owner-prompt-versions-title">
        <h2 id="owner-prompt-versions-title">Версии</h2>
        <ul class="owner-invite-list">
            {% for item in versions %}
            <li>
                <p>
                    <strong><a href="{{ key_path }}?version={{ item.version }}">Версия {{ item.version }}</a></strong>
                    — {{ item.source == 'owner' ? 'правка из кабинета' : 'файл в репозитории' }}{% if item.version == published_version %}, опубликована{% endif %}{% if item.version == selected_version %}, открыта сейчас{% endif %}.
                </p>
                {% if item.note %}<p>{{ item.note }}</p>{% endif %}
                {% if item.created_at %}<small>Сохранена {{ item.created_at|date("d.m.Y H:i") }}</small>{% endif %}
            </li>
            {% endfor %}
        </ul>

        <form method="post" action="{{ key_path }}/publish" class="owner-form">
            {{ csrf_field() }}
            <input type="hidden" name="version" value="{{ selected_version }}">
            <label class="owner-toggle">
                <input type="checkbox" name="confirm_publish" value="1" required>
                Понимаю: новые заказы будут использовать версию {{ selected_version }}; уже поставленные задания не меняются — у них снимок.
            </label>
            <button type="submit" class="btn btn-primary">Опубликовать эту версию</button>
        </form>

        <form method="post" action="{{ key_path }}/reset" class="owner-action-form">
            {{ csrf_field() }}
            <button type="submit" class="btn btn-outline btn-sm" title="Отменить правки из кабинета и снова использовать текст, который поставляется вместе с программой">Вернуть заводской текст (версия {{ manifest_version }})</button>
        </form>
    </section>

    <section class="owner-invites" aria-labelledby="owner-prompt-text-title">
        <h2 id="owner-prompt-text-title">Текст версии {{ selected_version }}</h2>
        <p class="owner-help">Источник: {{ selected.source ?: 'не указан' }}. Клинический контекст специалиста {{ selected.allowsOwnerContext ? 'принимается' : 'не принимается' }}.</p>
        <pre class="owner-prompt-text">{{ selected.text }}</pre>

        <div class="prompt-tools">
            <div class="prompt-tools__row">
                <a class="btn btn-outline btn-sm" href="{{ key_path }}/preview?version={{ selected_version }}">Показать запрос на тестовых данных</a>
                <p class="prompt-tools__hint">Тестовые данные — выдуманный набор ответов на опросник. По нему видно, что именно уйдёт модели; реальные клиенты не затрагиваются.</p>
            </div>

            <form method="post" action="{{ key_path }}/trial" class="prompt-trial">
                {{ csrf_field() }}
                <input type="hidden" name="version" value="{{ selected_version }}">
                <h3 class="prompt-trial__title">Пробный разбор на тестовых данных</h3>
                <p class="prompt-tools__hint">Промпт отправится модели на выдуманных данных, и вы увидите, какой разбор получится. Запрос платный, как обычный разбор; результат нигде не сохраняется, клиенты не затрагиваются.</p>
                <label class="prompt-trial__confirm">
                    <input type="checkbox" name="confirm_trial" value="1" required>
                    <span>Подтверждаю платный пробный запрос к модели</span>
                </label>
                <div class="prompt-trial__actions">
                    <button type="submit" class="btn btn-outline btn-sm"{% if not ai_enabled %} disabled{% endif %}>Запустить пробный разбор</button>
                    {% if not ai_enabled %}<span class="prompt-tools__hint">ИИ-разборы выключены в настройках.</span>{% endif %}
                </div>
            </form>
        </div>
    </section>

    {% if preview %}
    <section class="owner-invites" aria-labelledby="owner-prompt-preview-title">
        <h2 id="owner-prompt-preview-title">Предпросмотр запроса</h2>
        {% if preview.error %}
            <p class="owner-notice owner-notice--error" role="alert">{{ preview.error }}</p>
        {% else %}
            <p class="owner-help">
                Ровно то, что уйдёт модели. Ответы придуманы этой страницей по схеме методики — ни одной реальной сессии здесь нет.
                Провайдер при предпросмотре не вызывается.
            </p>
            {% if preview.glossary_mode %}
            <p class="owner-help">Глоссарий СМИЛ: {{ preview.glossary_mode == 'compact' ? 'компактный (краткое значение по шкалам 40–65T)' : 'полный' }}.</p>
            {% endif %}
            {% if preview.length %}
            <p class="owner-help">Длина контекста: {{ preview.length }} знаков.</p>
            {% endif %}
            <h3>system</h3>
            <pre class="owner-prompt-text">{{ preview.system }}</pre>
            <h3>user</h3>
            <pre class="owner-prompt-text">{{ preview.user }}</pre>
        {% endif %}
    </section>
    {% endif %}

    {% if trial %}
    <section class="owner-invites" aria-labelledby="owner-prompt-trial-title">
        <h2 id="owner-prompt-trial-title">Пробный разбор на тестовых данных</h2>
        {% if trial.error %}
            <p class="owner-notice owner-notice--error" role="alert">{{ trial.error }}</p>
        {% else %}
            <p class="owner-help">Ответ модели{% if trial.model %} ({{ trial.model }}){% endif %}. Он не сохранён и исчезнет при перезагрузке страницы.</p>
            <div class="ai-report__body">{{ trial.text|raw }}</div>
        {% endif %}
    </section>
    {% endif %}

    <section class="owner-invites" aria-labelledby="owner-prompt-new-title">
        <h2 id="owner-prompt-new-title">Новая версия</h2>
        <p class="owner-help">Основа — текст версии {{ selected_version }}. Сохранение не публикует: опубликовать нужно отдельной кнопкой.</p>
        <form method="post" action="{{ key_path }}/versions" class="owner-form" data-prompt-editor-form data-preview-url="{{ key_path }}/preview">
            {{ csrf_field() }}
            <div class="owner-field">
                <label for="prompt-text">Текст промпта</label>
                {# Поле остаётся источником правды: редактор правит его содержимое,
                   а без JS страница работает как прежде. #}
                <textarea id="prompt-text" name="text" rows="18" required data-prompt-editor>{{ selected.text }}</textarea>
            </div>

            {% if variables %}
            <div class="owner-prompt-vars" data-prompt-vars hidden>
                <label for="prompt-var-select">Вставить переменную</label>
                <select id="prompt-var-select" data-prompt-var-select>
                    <option value="">Поле входных данных…</option>
                    {% for variable in variables %}
                    <option value="{{ variable.key }}" title="{{ variable.hint }}">{{ variable.label }} ({{ variable.key }})</option>
                    {% endfor %}
                </select>
                <p class="owner-help" data-prompt-var-hint>Поля, которые модель получает во входных данных этой методики. Подстановки в тексте нет: промпт просто называет поле по имени.</p>
                <dl class="owner-prompt-vars__list">
                    {% for variable in variables %}
                    <div><dt>{{ variable.label }} <code>{{ variable.key }}</code></dt><dd>{{ variable.hint }}</dd></div>
                    {% endfor %}
                </dl>
            </div>
            {% endif %}

            <div class="owner-prompt-preview" data-prompt-preview-box hidden>
                <button type="button" class="btn btn-outline btn-sm" data-prompt-preview-toggle aria-expanded="false">Предпросмотр</button>
                <p class="owner-help" data-prompt-stats></p>
                <div data-prompt-preview-panel hidden>
                    <p class="owner-notice owner-notice--error" role="alert" data-prompt-preview-error hidden></p>
                    <p class="owner-help" data-prompt-preview-meta></p>
                    <h3>system</h3>
                    <pre class="owner-prompt-text" data-prompt-preview-system></pre>
                    <h3>user</h3>
                    <pre class="owner-prompt-text" data-prompt-preview-user></pre>
                </div>
            </div>

            <label for="prompt-note">Заметка о правке</label>
            <input type="text" id="prompt-note" name="note" maxlength="{{ note_max }}">

            <label class="owner-toggle">
                <input type="checkbox" name="allows_owner_context" value="1"{% if selected.allowsOwnerContext %} checked{% endif %}>
                Принимает клинический контекст специалиста
            </label>

            <button type="submit" class="btn btn-primary">Сохранить как новую версию</button>
        </form>
    </section>
</section>
{% endblock %}

{# Редактор лежит локально: внешних CDN в кабинете нет. #}
{% block extra_css %}
<link rel="stylesheet" href="{{ asset('vendor/toastui-editor/toastui-editor.min.css') }}">
{% endblock %}

{% block extra_js %}
<script src="{{ asset('vendor/toastui-editor/toastui-editor-all.min.js') }}"></script>
<script src="{{ asset('vendor/toastui-editor/i18n/ru-ru.min.js') }}"></script>
<script src="{{ asset('js/owner-prompt-editor.js') }}"></script>
{% endblock %}
