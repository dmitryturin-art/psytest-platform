{% extends "layout.twig" %}

{% block title %}Подтверждение входа — {{ appName }}{% endblock %}
{% block body_class %}account-page{% endblock %}

{% block content %}
<div class="account-wrapper">
    <h1>Подтверждение входа</h1>

    <p>Нажмите кнопку, чтобы войти. Ссылка одноразовая и действует 15 минут.</p>

    <form method="post" action="{{ basePath }}/account/login/{{ token }}" class="account-form">
        {{ csrf_field() }}
        <button type="submit" class="btn btn-primary">Войти в кабинет</button>
    </form>
</div>
{% endblock %}
