{% extends "layout.twig" %}
{# Подтверждение без JavaScript для корзины карточек клиентов (07.K11). #}
{% set ownerArea = true %}

{% block title %}Подтверждение — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">К приглашениям</a><a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-confirm-title">
    <p class="owner-panel-eyebrow">Подтверждение</p>
    <h1 id="owner-confirm-title">{% if action == 'purge' %}Удалить карточку окончательно?{% else %}Отправить карточку в корзину?{% endif %}</h1>
    <p class="owner-panel-intro">Карточка: «{{ client.label }}». Назначений: {{ assignments_total }}.</p>
    {% if action == 'purge' %}
        <p class="owner-notice owner-notice--error">Карточка и все её назначения будут стёрты сразу, без возможности восстановления: ответы, результаты, разборы и их версии, выгрузки, заметки.</p>
    {% else %}
        <p class="owner-notice owner-notice--success">Карточка и её назначения переместятся в корзину. Через {{ trash_days }} дней всё будет удалено окончательно: ответы, результаты, разборы, выгрузки. До этого карточку можно восстановить.</p>
    {% endif %}
    <form method="post" action="{{ basePath }}/admin/clients/{{ client.id }}/{{ action }}" class="owner-action-form owner-delete-form" data-submit-once>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="form_key" value="{{ trash_form_key }}">
        <input type="hidden" name="confirmed" value="1">
        <input type="hidden" name="return" value="{{ return_url }}">
        {% if action == 'purge' %}
            <label><input type="checkbox" name="confirm_delete" value="delete" required> Я понимаю, что удаление необратимо.</label>
        {% endif %}
        <p class="owner-invite-actions">
            <button type="submit" class="btn btn-danger" data-busy-text="Выполняем…">{% if action == 'purge' %}Удалить сейчас{% else %}В корзину{% endif %}</button>
            <a class="btn btn-outline" href="{{ basePath }}{{ return_url }}">Отмена</a>
        </p>
    </form>
</section>
{% endblock %}

{% block extra_js %}
<script src="{{ asset('js/owner-forms.js') }}"></script>
{% endblock %}
