{% extends "layout.twig" %}
{# Подтверждение без JavaScript: действие выполняется только отсюда (07.K8). #}
{% set ownerArea = true %}

{% block title %}Подтверждение — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}<nav class="owner-nav"><a class="nav-link" href="{{ basePath }}/admin">К приглашениям</a><a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a></nav>{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-confirm-title">
    <p class="owner-panel-eyebrow">Подтверждение</p>
    <h1 id="owner-confirm-title">{% if action == 'purge' %}Удалить окончательно?{% else %}Переместить в корзину?{% endif %}</h1>
    <p class="owner-panel-intro">Выбрано приглашений: {{ count }}.</p>
    {% if action == 'purge' %}
        <p class="owner-notice owner-notice--error">Ответы, результат, разборы и их версии, выгрузки и заметка будут стёрты без возможности восстановления. Карточка клиента останется.</p>
    {% else %}
        <p class="owner-notice owner-notice--success">Кейс переместится в корзину и будет окончательно удалён через {{ trash_days }} дней: ответы, результат, разборы и их версии, выгрузки. Карточка клиента останется. До этого его можно восстановить.</p>
    {% endif %}
    <form method="post" action="{{ basePath }}/admin/invites/{{ action }}" class="owner-action-form owner-delete-form" data-submit-once>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="form_key" value="{{ bulk_form_key }}">
        <input type="hidden" name="confirmed" value="1">
        <input type="hidden" name="return" value="{{ return_url }}">
        {% for id in invite_ids %}<input type="hidden" name="invite_ids[]" value="{{ id }}">{% endfor %}
        {% if action == 'purge' %}
            <label><input type="checkbox" name="confirm_delete" value="delete" required> Я понимаю, что удаление необратимо.</label>
        {% endif %}
        <p class="owner-invite-actions">
            <button type="submit" class="btn btn-danger" data-busy-text="Выполняем…">{% if action == 'purge' %}Удалить сейчас{% else %}В корзину{% endif %}</button>
            <a class="btn btn-outline" href="{{ basePath }}{{ return_url }}">Отмена</a>
        </p>
    </form>
</section>
{% endblock %}

{% block extra_js %}
<script src="{{ asset('js/owner-forms.js') }}"></script>
{% endblock %}
