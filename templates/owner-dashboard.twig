{% extends "layout.twig" %}
{# Кабинет владельца — отдельная сессия: навигация посетителя сюда не входит. #}
{% set ownerArea = true %}

{% block title %}Кабинет владельца — {{ appName }}{% endblock %}
{% block body_class %}owner-dashboard-page{% endblock %}
{% block header_nav %}
<nav class="owner-nav">
    <a class="nav-link" href="{{ basePath }}/admin/clients">Клиенты</a>
    <a class="nav-link" href="{{ basePath }}/admin/prompts">Промпты</a>
    <form method="post" action="{{ basePath }}/admin/logout">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="nav-link owner-logout">Выйти</button>
    </form>
</nav>
{% endblock %}

{% block content %}
<section class="owner-panel" aria-labelledby="owner-dashboard-title">
    <p class="owner-panel-eyebrow">Технический доступ</p>
    <h1 id="owner-dashboard-title">Кабинет владельца</h1>
    <p class="owner-panel-intro">Найдите результат по полной ссылке или токену. Токен не попадает в адрес страницы и не сохраняется в журнале кабинета.</p>

    {% if flash %}
        <p class="owner-notice owner-notice--{{ flash.type }}" role="status">{{ flash.message }}</p>
        {% if flash.invite_url %}<p class="owner-invite-url"><input aria-label="Ссылка-приглашение" type="text" readonly value="{{ flash.invite_url }}"></p>{% endif %}
    {% endif %}
    {% if lookup_error %}
        <p class="owner-notice owner-notice--error" role="alert">{{ lookup_error }}</p>
    {% endif %}

    <section class="owner-invites" aria-labelledby="owner-invites-title">
        <h2 id="owner-invites-title">Новое приглашение</h2>
        <p class="owner-help">Ссылка действует 14 дней и может быть открыта один раз. Ответы и результат после открытия будут доступны только в этом кабинете.</p>
        {# form_key — одноразовый ключ этой отрисовки: повторная отправка той же
           формы (двойной клик) не создаёт второе приглашение (07.K6a). #}
        <form method="post" action="{{ basePath }}/admin/invites/create" class="owner-form" data-submit-once>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="form_key" value="{{ invite_form_key }}">
            <label for="invite-test">Методика</label>
            <select id="invite-test" name="test_id" required>
                {% for test in invite_tests %}<option value="{{ test.id }}">{{ test.name }}</option>{% endfor %}
            </select>
            <label for="invite-client">Клиент (необязательно)</label>
            <select id="invite-client" name="client_id" data-new-client-select>
                <option value="">Без карточки клиента</option>
                <option value="__new__">Новый клиент…</option>
                {% for client in clients %}<option value="{{ client.id }}">{{ client.label }}</option>{% endfor %}
            </select>
            <div class="owner-new-client" data-new-client-field>
                <label for="invite-new-client">Имя нового клиента <small data-new-client-hint>(только если выбран «Новый клиент…»)</small></label>
                <input id="invite-new-client" name="new_client_label" type="text" maxlength="120" autocomplete="off">
            </div>
            <label for="invite-note">Заметка для себя (не показывается клиенту)</label>
            <textarea id="invite-note" name="owner_note" maxlength="1000" rows="3"></textarea>
            <button type="submit" class="btn btn-primary" data-busy-text="Создаём…">Создать ссылку</button>
        </form>
    </section>

    <section class="owner-invites" aria-labelledby="owner-invites-history-title">
        <h2 id="owner-invites-history-title">Приглашения</h2>

        {# Фильтры (07.K8): форма GET, состояние живёт в адресе страницы. #}
        <form method="get" action="{{ basePath }}/admin" class="filter-bar" role="search" aria-label="Фильтры приглашений">
            <div class="filter-bar__field">
                <label for="filter-client">Клиент</label>
                <select id="filter-client" name="client">
                    <option value="">Все клиенты</option>
                    <option value="none"{% if filter.withoutClient %} selected{% endif %}>Без клиента</option>
                    {% for client in clients %}<option value="{{ client.id }}"{% if filter.clientId == client.id %} selected{% endif %}>{{ client.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="filter-bar__field">
                <label for="filter-test">Методика</label>
                <select id="filter-test" name="test">
                    <option value="">Все методики</option>
                    {% for test in invite_tests %}<option value="{{ test.slug }}"{% if filter.testSlug == test.slug %} selected{% endif %}>{{ test.name }}</option>{% endfor %}
                </select>
            </div>
            <div class="filter-bar__field">
                <label for="filter-status">Статус</label>
                <select id="filter-status" name="status">
                    {% set status_options = {'active': 'Все активные', 'pending': 'Ожидает', 'opened': 'Открыто', 'completed': 'Завершено', 'revoked': 'Отозвано', 'expired': 'Срок истёк', 'archived': 'Архив', 'trash': 'Корзина'} %}
                    {% for value, label in status_options %}<option value="{{ value }}"{% if filter.status == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
            </div>
            <div class="filter-bar__field filter-bar__field--wide">
                <label for="filter-q">Поиск по заметке и клиенту</label>
                <input id="filter-q" name="q" type="search" maxlength="80" autocomplete="off" value="{{ filter.query }}">
            </div>
            <div class="filter-bar__actions">
                <button type="submit" class="btn btn-primary">Применить</button>
                {% if not filter.isDefault %}<a class="btn btn-outline" href="{{ basePath }}/admin">Сбросить</a>{% endif %}
            </div>
        </form>
        <p class="filter-counts" aria-live="polite">Показано: {{ invites|length }} · <a href="{{ basePath }}/admin?status=archived">в архиве: {{ invite_counts.archived ?? 0 }}</a> · <a href="{{ basePath }}/admin?status=trash">в корзине: {{ invite_counts.trash ?? 0 }}</a></p>
        {% if filter.status == 'trash' %}
            <p class="owner-help">Корзина очищается автоматически: через {{ trash_days }} дней кейс удаляется окончательно со всеми ответами, разборами и выгрузками. До этого его можно восстановить.</p>
        {% elseif filter.status == 'archived' %}
            <p class="owner-help">Архив ничего не удаляет и не меняет для клиента: ссылки на результат работают как раньше.</p>
        {% endif %}

        {# Общая форма действий: строки таблицы и панель выбранного привязаны к ней
           атрибутом form. form_key — одноразовый ключ этой отрисовки. #}
        <form method="post" action="{{ basePath }}/admin/invites/archive" id="invite-bulk-form" class="invite-bulk-form" data-bulk-form>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="form_key" value="{{ bulk_form_key }}">
            <input type="hidden" name="return" value="{{ filter_url }}">
            <input type="hidden" name="confirmed" value="" data-confirmed>
            <input type="hidden" name="confirm_delete" value="" data-confirm-delete>
        </form>

        {% if invites %}
            <div class="table-scroll">
            <table class="invite-table">
                <thead>
                    <tr>
                        <th scope="col" class="invite-table__check"><input type="checkbox" data-bulk-all aria-label="Выбрать все"></th>
                        <th scope="col">Методика</th>
                        <th scope="col">Клиент</th>
                        <th scope="col">Статус</th>
                        <th scope="col">Создано</th>
                        <th scope="col">Заметка</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                {% for invite in invites %}
                    <tr>
                        <td class="invite-table__check"><input type="checkbox" name="invite_ids[]" value="{{ invite.id }}" form="invite-bulk-form" data-bulk-row aria-label="Выбрать приглашение {{ invite.test_name }}"{% if invite.status == 'pending' and invite.display_status == 'pending' %} disabled{% endif %}></td>
                        <td data-label="Методика"><strong>{{ invite.test_name }}</strong></td>
                        <td data-label="Клиент">{% if invite.client_label %}<a href="{{ basePath }}/admin/clients/{{ invite.client_id }}">{{ invite.client_label }}</a>{% else %}<span class="owner-help">—</span>{% endif %}</td>
                        <td data-label="Статус">{% include 'blocks/owner-invite-status.twig' %}{% if invite.trashed_at and invite.purge_at %}<small class="invite-table__hint">будет удалён {{ invite.purge_at|date("d.m.Y") }}</small>{% endif %}</td>
                        <td data-label="Создано">{{ invite.created_at|date("d.m.Y") }}</td>
                        <td data-label="Заметка" class="invite-table__note">{% if invite.owner_note %}<span title="{{ invite.owner_note }}">{{ invite.owner_note|length > 80 ? invite.owner_note|slice(0, 80) ~ '…' : invite.owner_note }}</span>{% endif %}</td>
                        <td data-label="Действия" class="invite-table__actions"><div class="invite-actions">
                            {% if invite.status == 'pending' and invite.display_status == 'pending' %}
                                <form method="post" action="{{ basePath }}/admin/invites/revoke" class="owner-action-form">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="invite_id" value="{{ invite.id }}">
                                    <button type="submit" class="btn btn-danger btn-sm">Отозвать</button>
                                </form>
                            {% endif %}
                            {% if invite.claimed_session_id %}
                                <a class="btn btn-outline btn-sm" href="{{ basePath }}/admin/invited-case/{{ invite.claimed_session_id }}">Открыть кейс</a>
                            {% endif %}
                            {% if invite.status == 'revoked' and not invite.claimed_session_id and not invite.trashed_at %}
                                {# Отозванное и не открытое приглашение можно убрать из
                                   списка сразу (07.K6c): клиентских данных за ним нет. #}
                                <form method="post" action="{{ basePath }}/admin/invites/delete" class="owner-action-form" data-submit-once>
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="invite_id" value="{{ invite.id }}">
                                    <button type="submit" class="btn btn-danger btn-sm" data-busy-text="Удаляем…">Удалить</button>
                                </form>
                                {% include 'blocks/owner-invite-actions.twig' with {hide_trash: true} %}
                            {% else %}
                                {% include 'blocks/owner-invite-actions.twig' %}
                            {% endif %}
                        </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <div class="bulk-bar">
                <div class="bulk-bar__inner" data-bulk-bar>
                    <span class="bulk-bar__count">Выбрано: <strong data-bulk-count>0</strong></span>
                    {% if filter.status == 'trash' %}
                        <button type="submit" form="invite-bulk-form" class="btn btn-outline btn-sm" formaction="{{ basePath }}/admin/invites/restore">Восстановить</button>
                        <button type="submit" form="invite-bulk-form" class="btn btn-danger btn-sm" formaction="{{ basePath }}/admin/invites/purge" data-confirm="purge">Удалить сейчас</button>
                    {% else %}
                        {% if filter.status == 'archived' %}
                            <button type="submit" form="invite-bulk-form" class="btn btn-outline btn-sm" formaction="{{ basePath }}/admin/invites/unarchive">Из архива</button>
                        {% else %}
                            <button type="submit" form="invite-bulk-form" class="btn btn-outline btn-sm" formaction="{{ basePath }}/admin/invites/archive">В архив</button>
                        {% endif %}
                        <button type="submit" form="invite-bulk-form" class="btn btn-danger btn-sm" formaction="{{ basePath }}/admin/invites/trash" data-confirm="trash">В корзину</button>
                    {% endif %}
                </div>
            </div>
        {% elseif filter.isDefault %}<p class="owner-help">Приглашений пока нет.</p>
        {% else %}<p class="owner-help">По этим условиям ничего не найдено. <a href="{{ basePath }}/admin">Сбросить фильтры</a></p>{% endif %}
    </section>

    {% include 'blocks/owner-invite-dialog.twig' %}

    <form method="post" action="{{ basePath }}/admin/case/lookup" class="owner-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label for="result-reference">Ссылка на результат или токен</label>
        <input id="result-reference" name="result_reference" type="text" inputmode="url" autocomplete="off" required>
        <button type="submit" class="btn btn-primary">Найти сессию</button>
    </form>

    {% if case %}
        <section class="owner-case" aria-labelledby="owner-case-title">
            <h2 id="owner-case-title">Найденная сессия</h2>
            <dl class="owner-case-details">
                <div><dt>Методика</dt><dd>{{ case.test_name }}</dd></div>
                <div><dt>Создана</dt><dd>{{ case.created_at|date("d.m.Y H:i") }}</dd></div>
                <div><dt>Статус</dt><dd><span class="status status--{{ case.status|status_tone }}">{{ case.status|status_label }}</span></dd></div>
                <div><dt>Режим хранения</dt><dd>{{ case.retention_class|retention_label }}</dd></div>
            </dl>

            {% if case_attached %}
                <p class="owner-notice owner-notice--success">Эта сессия уже привязана к карточке клиента.</p>
                <p><a class="btn btn-primary" href="{{ basePath }}/admin/invited-case/{{ case.id }}">Открыть кейс</a></p>
            {% else %}
                {% if case.retention_class == 'anonymous' and case.status == 'completed' %}
                    <form method="post" action="{{ basePath }}/admin/case/assign" class="owner-action-form">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="session_id" value="{{ case.id }}">
                        <button type="submit" class="btn btn-primary">Назначить как кейс клиента</button>
                    </form>
                    <p class="owner-help">После назначения эта сессия перестанет участвовать в автоматической 180-дневной очистке.</p>
                {% elseif case.retention_class == 'therapist_case' %}
                    <p class="owner-notice owner-notice--success">Это уже кейс клиента терапевта. Он хранится, пока вы не удалите его вручную.</p>
                {% elseif case.retention_class != 'account' %}
                    <p class="owner-notice owner-notice--error">Назначить можно только завершённую анонимную сессию.</p>
                {% endif %}

                {% if case.status == 'completed' and case.retention_class != 'account' %}
                    <form method="post" action="{{ basePath }}/admin/case/attach" class="owner-form owner-attach-form">
                        <h3>Привязать к клиенту</h3>
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="session_id" value="{{ case.id }}">
                        <label for="attach-client">Карточка клиента</label>
                        <select id="attach-client" name="client_id">
                            <option value="">Новый клиент</option>
                            {% for client in clients %}<option value="{{ client.id }}">{{ client.label }}</option>{% endfor %}
                        </select>
                        <label for="attach-label">Подпись нового клиента (нужна только для варианта «Новый клиент»)</label>
                        <input id="attach-label" name="new_client_label" type="text" maxlength="120" autocomplete="off">
                        <label for="attach-note">Заметка для себя (не показывается клиенту)</label>
                        <textarea id="attach-note" name="owner_note" maxlength="1000" rows="3"></textarea>
                        <button type="submit" class="btn btn-primary">Привязать к клиенту</button>
                    </form>
                    <p class="owner-help">Привязывается только эта сессия: в парном Лазарусе партнёрская остаётся отдельной и не попадает в карточку. Ссылка-приглашение при этом не создаётся — открыть кейс можно только здесь, в кабинете.</p>
                {% elseif case.retention_class == 'account' %}
                    <p class="owner-notice owner-notice--error">Эта сессия сохранена в кабинете посетителя и принадлежит ему: привязать её к карточке клиента нельзя.</p>
                {% endif %}

                {% if case.retention_class == 'therapist_case' %}
                    <form method="post" action="{{ basePath }}/admin/case/delete" class="owner-action-form owner-delete-form">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="session_id" value="{{ case.id }}">
                        <label><input type="checkbox" name="confirm_delete" value="delete" required> Я понимаю, что удаление необратимо.</label>
                        <button type="submit" class="btn btn-danger">Удалить кейс полностью</button>
                    </form>
                {% endif %}
            {% endif %}
        </section>
    {% endif %}
</section>
{% endblock %}

{% block extra_js %}
{# Блокировка кнопки после отправки и поле «Новый клиент…». Без JS форма
   работает целиком: поле имени просто всегда видно, а повтор ловит сервер. #}
<script src="{{ asset('js/owner-forms.js') }}"></script>
<script src="{{ asset('js/owner-invites.js') }}"></script>
{% endblock %}
