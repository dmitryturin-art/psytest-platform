<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}{{ appName }}{% endblock %}</title>
    <meta name="description" content="{% block description %}Психологическое тестирование онлайн{% endblock %}">
    
    <!-- Favicon -->
    <link rel="icon" href="{{ basePath }}/favicon.ico" type="image/x-icon">
    
    <!-- Styles -->
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
    {% block extra_css %}{% endblock %}
    
    <!-- Privacy & Security -->
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="strict-origin-when-cross-origin">
</head>
<body class="{% block body_class %}{% endblock %}">
    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <div class="header-content">
                <a href="{{ basePath }}/" class="logo">
                    <span class="logo-icon">🧠</span>
                    <span class="logo-text">{{ appName }}</span>
                </a>
                {% block header_nav %}
                <nav class="header-nav">
                    {% if showTestsLink|default(true) %}
                    <a href="{{ basePath }}/tests" class="nav-link">Все тесты</a>
                    {% endif %}
                </nav>
                {% endblock %}
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="site-main {% block main_class %}{% endblock %}">
        {% block main_content %}
            <div class="container">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-info">
                    <p>&copy; {{ "now"|date("Y") }} {{ appName }}. Все права защищены.</p>
                    <p class="footer-disclaimer">
                        Результаты тестирования носят ознакомительный характер и не заменяют 
                        очную консультацию специалиста.
                    </p>
                </div>
                <div class="footer-links">
                    <a href="{{ basePath }}/privacy" class="footer-link">Конфиденциальность</a>
                    <a href="{{ basePath }}/terms" class="footer-link">Условия использования</a>
                    <a href="https://hypnocorrection.ru/" class="footer-link">О специалисте</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="{{ asset('js/main.js') }}"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>
