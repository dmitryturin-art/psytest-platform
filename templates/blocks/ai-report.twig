<section class="ai-report" data-ai-report data-mode="{{ ai_report.mode }}">
    <h2 class="ai-report__title">Расширенный разбор</h2>
    <p class="ai-report__intro">
        Подробный разбор результата, подготовленный языковой моделью по рассчитанным показателям.
        Он не заменяет консультацию специалиста и не является диагнозом.
    </p>

    {% if ai_report.restricted %}
        {% if ai_report.published %}
            {# Ровно та версия, которую специалист опубликовал. Черновик модели,
               профессиональное заключение и неопубликованные правки сюда не
               попадают: presenter их не возвращает. #}
            <div class="ai-report__item ai-report__item--published" data-kind="specialist">
                <h3 class="ai-report__item-title">Разбор специалиста</h3>
                <p class="ai-report__published-at">Опубликован {{ ai_report.published.published_at|date("d.m.Y") }}</p>
                <div class="ai-report__body">{{ ai_report.published.html|raw }}</div>
            </div>
        {% else %}
            <p class="ai-report__waiting" role="status">Расширенный разбор появится после проверки специалиста.</p>
        {% endif %}
    {% else %}

    {% for item in ai_report.kinds %}
    <div class="ai-report__item" data-kind="{{ item.kind }}" data-status="{{ item.status }}">
        {% if item.status == 'ready' %}
            {# Свёрнут по умолчанию: иначе разбор на несколько страниц сливается
               с результатом теста в один сплошной текст. #}
            <details class="ai-report__details">
                <summary class="ai-report__summary">
                    <span class="ai-report__summary-title">{{ item.title }}</span>
                    <span class="ai-report__summary-hint">готов — нажмите, чтобы прочитать</span>
                </summary>
                <div class="ai-report__body">{{ item.html|raw }}</div>
            </details>
        {% else %}
            <h3 class="ai-report__item-title">{{ item.title }}</h3>

            {% if item.status == 'pending' or item.status == 'running' %}
                <p class="ai-report__waiting" role="status">
                    Разбор готовится. Это занимает несколько минут — страницу можно закрыть и вернуться позже.
                </p>
            {% else %}
                {% if item.status == 'failed' %}
                <p class="ai-report__error" role="alert">
                    Не получилось подготовить разбор{% if item.failure_reason %}: {{ item.failure_reason }}{% endif %}. Можно попробовать снова.
                </p>
                {% endif %}
                {% if ai_report.ai_disabled|default(false) %}
                {# Общий выключатель владельца (07.WP9): предлагать заказ,
                   который сразу уйдёт в отказ, нечестно. #}
                <p class="ai-report__waiting" role="status">Разбор временно недоступен.</p>
                {% elseif ai_report.readonly %}
                {# В кабинете нет bearer-токена результата, а форма заказа его
                   несёт: разбор заказывается на странице по своей ссылке. #}
                <p class="ai-report__waiting" role="status">
                    Разбор заказывается на странице результата — откройте её по своей ссылке.
                </p>
                {% else %}
                <form method="post" action="{{ basePath }}/result/{{ test.slug }}/{{ session.session_token }}/report" data-ai-report-form>
                    {{ csrf_field() }}
                    <input type="hidden" name="kind" value="{{ item.kind }}">
                    <label>
                        <input type="checkbox" name="ai_consent" value="1" required>
                        Разрешаю передать обезличенные результаты теста внешнему AI-сервису для подготовки черновика разбора. Имя, email и ссылка на результат не передаются.
                    </label>
                    <button type="submit" class="btn btn-primary">
                        {{ item.status == 'failed' ? 'Попробовать снова' : 'Получить разбор' }}
                    </button>
                </form>
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
    {% endfor %}
    {% endif %}
</section>
