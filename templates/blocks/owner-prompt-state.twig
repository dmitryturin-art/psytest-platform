{# Состояние одного промпта словами (07.K14): точка статуса и подпись.
   Параметр p — строка из OwnerController::promptState(). Черновик называется только
   для правок из кабинета и заготовок; заготовка — «черновик (заготовка)», без номера. #}
{% set draft_name = p.draft_is_stub ?? false ? 'черновик (заготовка)' : 'черновик версии ' ~ p.draft_version %}
{% if not p.exists %}<span class="status status--muted">нет</span>
{% elseif p.published_version is not null %}<span class="status status--done">опубликована версия {{ p.published_version }}</span>{% if p.draft_version %}<span class="prompt-state__more">есть {{ draft_name }}</span>{% endif %}
{% else %}<span class="status status--pending">{{ draft_name }}</span><span class="prompt-state__more">не опубликован</span>{% endif %}
