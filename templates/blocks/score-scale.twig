{# Ось шкалы начинается с минимума первой зоны, а не с нуля: у Лазаруса это 16,
   и отсчёт от нуля смещал маркер вправо — балл 79 («неудовлетворённость»)
   рисовался внутри зелёной зоны «удовлетворённость». #}
{% set scale_min = thresholds|first.min ?? 0 %}
{% set scale_max = thresholds|last.max ?? max %}
{% set scale_span = scale_max - scale_min %}
{% set scale_pct = scale_span > 0 ? (((score - scale_min) / scale_span * 100)|round(1)) : 0 %}
{% set scale_pct = scale_pct < 0 ? 0 : (scale_pct > 100 ? 100 : scale_pct) %}
<div class="score-badge__scale" aria-label="{{ label|default('Результат') }}: {{ score }} из {{ max }}">
    {% for name, range in thresholds %}
        <div class="score-badge__zone score-badge__zone--{{ name }}"
             style="flex-grow: {{ range.max - range.min + 1 }};{% if loop.first %} border-radius: 7px 0 0 7px;{% endif %}{% if loop.last %} border-right: none; border-radius: 0 7px 7px 0;{% endif %}"
             title="{{ name }}: {{ range.min }}–{{ range.max }}">
        </div>
    {% endfor %}
    <div class="score-badge__marker" style="left: {{ scale_pct }}%;"></div>
</div>
<div class="score-badge__scale-labels" aria-hidden="true">
    {% for name, range in thresholds %}
        {% if loop.first %}
        <span class="score-badge__scale-label">{{ range.min }}</span>
        {% endif %}
        {% if loop.last %}
        <span class="score-badge__scale-label" style="margin-left: auto;">{{ range.max }}</span>
        {% endif %}
    {% endfor %}
</div>
