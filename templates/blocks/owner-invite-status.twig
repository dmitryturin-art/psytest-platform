{# Метка состояния приглашения для кабинета (07.K8). Архив и корзину показывают вкладки списка (04.D2), поэтому отдельной отметки рядом нет. #}
<span class="status status--{{ (invite.display_status ?: 'pending')|status_tone }}">{% if invite.display_status == 'completed' %}завершено
{% elseif invite.display_status == 'opened' %}открыто
{% elseif invite.display_status == 'revoked' %}отозвано
{% elseif invite.display_status == 'expired' %}срок истёк
{% elseif invite.display_status == 'result_deleted' %}результат удалён
{% else %}ожидает открытия{% endif %}</span>
