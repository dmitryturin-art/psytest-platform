{# pdf_heading — заголовок секции только для PDF: в вебе его выводит страница результата. #}
{% if pdf_heading is defined and pdf_heading and _pdf|default(false) %}<h2>{{ pdf_heading }}</h2>{% endif %}
<div class="interpretation-block interpretation-block--simple">
    {% if text is defined and text %}
    <p class="interpretation-text">{{ text }}</p>
    {% endif %}
</div>
