# PsyTest Platform Configuration

# Database configuration
DB_HOST=localhost
# Порт MySQL. 3306 — обычный случай; менять нужно, только если база
# слушает другой порт (например MySQL 5.7 в Docker для bin/local-gate.sh).
DB_PORT=3306
DB_NAME=psytest
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application settings
APP_NAME=PsyTest
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true

# Session settings
SESSION_TTL_DAYS=30
ANONYMOUS_RETENTION_DAYS=180
SESSION_TOKEN_LENGTH=32

# Security
CSRF_ENABLED=true
# The owner dashboard stays disabled until this is set to an Argon2id hash.
# Generate it locally with:
# php -r 'echo password_hash("replace-with-a-long-password", PASSWORD_ARGON2ID), PHP_EOL;'
OWNER_DASHBOARD_PASSWORD_HASH=
OWNER_DASHBOARD_SESSION_TTL_MINUTES=120
OWNER_DASHBOARD_LOGIN_MAX_ATTEMPTS=10
OWNER_DASHBOARD_LOGIN_WINDOW_MINUTES=15
# Reserved configuration only: the current code does not encrypt stored clinical
# data just because this variable exists. Leave it unset unless a future,
# separately reviewed encryption implementation uses it.
ENCRYPTION_KEY=

# Legacy settings: public YooMoney and AI routes are retired. Do not put live
# payment or AI credentials here; YooKassa and the new AI provider boundary
# will receive separate configuration only in their approved implementation phases.
YOOMONEY_SHOP_ID=
YOOMONEY_API_KEY=
YOOMONEY_WEBHOOK_SECRET=

# Провайдер ИИ (D-039). Подходит любой сервис с OpenAI-совместимым
# chat/completions: смена провайдера — это смена AI_BASE_URL и AI_API_KEY.
# Ключ живёт только здесь и никогда не попадает в Git.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Идентификатор модели можно вписать вручную или выбрать из каталога провайдера.
# Указывайте конкретную модель, а не маршрутизатор. Проверено на практике:
# openrouter/free выбирает исполнителя сам и дважды отдавал клинический
# разбор моделям не того назначения — классификатору безопасности и модели
# для кода. Рабочая модель по решению владельца — qwen/qwen3.7-plus (D-041). Платные клиенты — только на платной модели
# с политикой без обучения на запросах.
AI_MODEL=qwen/qwen3.7-plus
# Разбор — длинный текст: замеры дали 86–100 с на индивидуальном отчёте
# и больше на парном. Занижать этот таймаут значит обрывать работающий запрос.
AI_TIMEOUT_SECONDS=300

# Исторические имена тех же настроек; используются, если AI_* не заданы.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Email settings (for sending interpretations)
MAIL_FROM=noreply@psytest.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls

# File storage
PDF_STORAGE_PATH=/var/www/psytest/storage/pdfs
UPLOAD_MAX_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_PATH=/var/www/psytest/storage/logs
